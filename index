.tabs{display:flex;gap:4px;background:rgba(122,108,240,.09);border-radius:18px;padding:4px;margin:6px 0 14px}
.tabs button{flex:1;background:none;color:var(--mu);box-shadow:none;border-radius:14px;padding:8px 2px;font-size:13px;font-weight:400}
.tabs button.on{background:var(--card);color:var(--ac);font-weight:700;box-shadow:0 2px 8px rgba(122,108,240,.2)}
.li{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 0;border-bottom:1.5px dashed var(--bd);font-size:13px}
