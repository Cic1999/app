details>summary{cursor:pointer;list-style:none}details>summary::-webkit-details-marker{display:none}
table.sm{width:100%;border-collapse:collapse;font-size:13px}
table.sm td,table.sm th{padding:8px 3px;border-bottom:1.5px dashed var(--bd);text-align:right;font-weight:400}
table.sm th{color:var(--ac);font-weight:700}
table.sm td:first-child,table.sm th:first-child{text-align:left;color:var(--mu)}
textarea{width:100%;height:90px;font-size:12px}
.fr{display:grid;grid-template-columns:1fr 64px 64px;gap:6px;align-items:center;margin:5px 0;font-size:13px}.fr input{width:100%;padding:5px 7px}
