for(const x of L)if(inF(x.c))rows.push({d:x.d,t:'buy',h:`<div class="li"><span><b class="up">買進</b> ${nm(x.c)} ${f0(x.q)}股 @${x.p}${x.q-x.rem?`<span class="tag">已賣 ${f0(x.q-x.rem)}</span>`:''}<br><span class="mu">手續費 ${f0(x.bf)}${x.f.t==='etf'?`｜經理費累計 ${f0(x.mg)}（每天 ${x.dm.toFixed(2)}）｜保管費累計 ${f0(x.cu)}（每天 ${x.dc.toFixed(2)}）`:'｜個股無內扣費'}</span></span><button class="s" data-dl="${x.i}">刪</button></div>`});
for(const s of SL)if(inF(s.c))rows.push({d:s.d,t:'sell',h:`<div class="li"><span><b class="dn">賣出</b> ${nm(s.c)} ${f0(s.q)}股 @${s.p}<br><span class="mu">手續費 ${f0(s.sf)}｜證交稅 ${f0(s.tax)}｜損益 <span class="${cl(s.pl)}">${sg(s.pl)}</span></span></span><button class="s" data-ds="${s.i}">刪</button></div>`});
for(const d of D)if(inF(d.c))rows.push({d:d.ex,t:'div',h:`<div class="li"><span><b>股息</b> ${nm(d.c)} <span class="tag">${d.act?'實收':d.use?'估算':'未計入'}</span><br><span class="mu">除息 ${d.ex}｜每股 ${d.per} × ${f0(d.sh)} 股｜${d.rec?'已入帳':'預計 '+d.pay+' 入帳'}</span></span><span class="r"><b>${d.use?f0(d.amt):'—'}</b><br><input type="number" data-a="${d.key}" placeholder="實收" value="${d.act?d.amt:''}"></span></div>`});
S.mdiv.forEach((m,i)=>{if(inF(m[0]))rows.push({d:m[1],t:'div',h:`<div class="li"><span><b>股息</b> ${nm(m[0])} <span class="tag">手動</span><br><span class="mu">入帳 ${m[1]}</span></span><span class="r"><b>${f0(m[2])}</b> <button class="s" data-dm="${i}">刪</button></span></div>`})});
rows.sort((a,b)=>b.d.localeCompare(a.d));
h=`<details class="card"><summary><b>✏️ 新增記錄</b></summary><div class="f" style="margin-top:10px">
<select id="rt" class="w"><option value="buy">買進</option><option value="sell">賣出</option><option value="div">股息（我實際收到的）</option></select>
<select id="rc" class="w">${Object.keys(S.funds).map(c=>`<option value="${c}" ${F===c?'selected':''}>${c} ${nm(c)}</option>`).join('')}</select>
<input type="date" id="rd" value="${tdy()}" class="w"><div class="mu w" id="rdl">日期</div>
<input type="number" id="rq" placeholder="股數" inputmode="numeric"><input type="number" id="rp" placeholder="成交價" step="0.01" inputmode="decimal">
<input type="number" id="rf" placeholder="手續費（留空自動算）" inputmode="numeric"><input type="number" id="rx" placeholder="證交稅（留空自動算）" inputmode="numeric">
<input type="number" id="ra" placeholder="實際入帳金額" inputmode="numeric" class="w" style="display:none">
<button class="w" onclick="addRec()">儲存</button></div></details>
<div class="chips">${[['all','全部'],['buy','買進'],['sell','賣出'],['div','股息']].map(([k,t])=>`<button class="chip ${RT===k?'on':''}" data-rt="${k}">${t}</button>`).join('')}</div>
<div class="card">${rows.filter(r=>RT==='all'||r.t===RT).map(r=>r.h).join('')||'<div class="mu">沒有符合的記錄。</div>'}</div>
<div class="mu">股息列的「實收」欄可直接改成你實際入帳的金額。</div>`}
if(TAB==='sim')h=`<div class="card f" id="simf"><div class="mu w">想買某檔？輸入股數和價格，看看買下去之後均價與各項數字怎麼變。這裡不會改動你的記錄。</div>
<select id="mc" class="w">${Object.keys(S.funds).map(c=>`<option value="${c}" ${(F!=='all'?F:'0050')===c?'selected':''}>${c} ${nm(c)}</option>`).join('')}</select>
<input type="number" id="mn" placeholder="打算買幾股" inputmode="numeric"><input type="number" id="mp" placeholder="預計成交價" step="0.01" inputmode="decimal">
<input type="number" id="mf" placeholder="手續費（留空自動算）" inputmode="numeric" class="w"></div>
<div class="card" id="simout"></div>
<button style="width:100%" onclick="simAdd()">我真的買了，加入記錄</button>`;
if(TAB==='set')h=`<div class="card"><b>🌼 股息計算方式</b><div class="mu">「估算」會依你的買進日與公告配息自動算；若與實際不符，改成「只算我輸入的」，就只計入你填的實收與手動新增。</div>
<select id="dm" style="margin-top:6px;width:100%"><option value="est" ${S.divMode==='est'?'selected':''}>估算，有填實收就用實收</option><option value="manual" ${S.divMode==='manual'?'selected':''}>只算我輸入的</option></select></div>
<div class="card"><b>🏷️ 費率</b><div class="mu">內扣費率（每年 %）與買賣手續費。內扣費已含在股價裡，這裡只用來估算被扣了多少。</div>
<div class="fr"><span>手續費 %／最低元</span><input type="number" step="0.0001" data-s="rate" value="${S.set.rate}"><input type="number" data-s="min" value="${S.set.min}"></div><div class="fr mu"><span></span><span>經理費</span><span>保管費</span></div>${Object.keys(S.funds).filter(c=>S.funds[c].t==='etf').map(c=>`<div class="fr"><span>${nm(c)}</span><input type="number" step="0.005" data-m="${c}" value="${S.funds[c].m}"><input type="number" step="0.005" data-c="${c}" value="${S.funds[c].c}"></div>`).join('')}</div>
<div class="card"><b>💾 備份與還原</b><div class="mu">資料只存在這支手機的瀏覽器裡。換手機或清除瀏覽器資料前，請先「匯出」並存到備忘錄。</div><textarea id="bk"></textarea><p><button class="s" onclick="exp()">匯出</button> <button class="s" onclick="imp()">匯入還原</button></p></div>
<div class="mu">內扣費用為估算值；賣出費用與券商可能有小差異。</div>`;
$('v').innerHTML=h;if(TAB==='sim'){$('mp').value=S.prices[$('mc').value]||'';sim()}if(TAB==='rec')rtf()}
function rtf(){const t=$('rt').value;$('rq').style.display=$('rp').style.display=$('rf').style.display=t==='div'?'none':'';$('rx').style.display=t==='sell'?'':'none';$('ra').style.display=t==='div'?'':'none';$('rdl').textContent=t==='div'?'入帳日期':'成交日期'}
function be(q,cost,t){if(q<=0)return 0;const r=S.set.rate/100;let p=cost/(q*(1-r-t));if(q*p*r<S.set.min)p=(cost+S.set.min)/(q*(1-t));return p}
function sim(){const c=$('mc').value,n=+$('mn').value||0,p=+$('mp').value||0,fx=$('mf').value,f=S.funds[c],r=LC.R[c]||{q:0,cost:0},price=+S.prices[c]||p,t=txr(c);
const bf=n>0&&p>0?(has(fx)?+fx:fee(n*p)):0,cost2=r.cost+n*p+bf,q2=r.q+n;
const pl=(q,co)=>{const mv=q*price;return q>0?mv-fee(mv)-Math.floor(mv*t)-co:0};
const rt=(f.m+f.c)/100,mv1=r.q*price,mv2=q2*price;
const rows=[['持有股數',r.q,q2,f0],['成本均價（含手續費）',r.q?r.cost/r.q:0,q2?cost2/q2:0,x=>x.toFixed(2)],['投入成本',r.cost,cost2,f0],['市值（以現價 '+price+'）',mv1,mv2,f0],['賣出後損益',pl(r.q,r.cost),pl(q2,cost2),f0,1],['損益兩平價（含賣出費用）',be(r.q,r.cost,t),be(q2,cost2,t),x=>x.toFixed(2)],['內扣費用／天',r.cost*rt/365,cost2*rt/365,x=>x.toFixed(2)],['佔全部市值比重',LC.mvAll?mv1/LC.mvAll*100:0,(LC.mvAll+n*price)?mv2/(LC.mvAll+n*price)*100:0,x=>x.toFixed(1)+'%']];
$('simout').innerHTML=n>0&&p>0?`<div class="mu">這筆買進手續費約 ${f0(bf)} 元，共花 ${f0(n*p+bf)} 元</div><table class="sm"><tr><th></th><th>目前</th><th>買進後</th><th>變化</th></tr>`+rows.map(([l,a,b,fm,sgn])=>`<tr><td>${l}</td><td>${sgn?sg(a):fm(a)}</td><td><b>${sgn?sg(b):fm(b)}</b></td><td>${(b-a>0?'+':b-a<0?'−':'')+fm(Math.abs(b-a))}</td></tr>`).join('')+'</table>':'<div class="mu">輸入股數和價格後，這裡會顯示買進前後的比較。</div>'}
function simAdd(){const c=$('mc').value,n=+$('mn').value,p=+$('mp').value,fx=$('mf').value;if(!(n>0)||!(p>0)){alert('請先輸入股數與價格');return}if(!confirm('把這筆加入買進記錄（日期為今天）？'))return;S.lots.push([c,tdy(),n,p,fx===''?null:+fx]);save();TAB='rec';render()}
function addRec(){const t=$('rt').value,c=$('rc').value,d=$('rd').value,q=+$('rq').value,p=+$('rp').value,fx=$('rf').value,tx=$('rx').value,a=+$('ra').value;
if(!d){alert('請填日期');return}
if(t==='div'){if(!(a>0)){alert('請填實際入帳金額');return}S.mdiv.push([c,d,a])}
else{if(!(q>0)||!(p>0)){alert('請填股數與成交價');return}
if(t==='buy'){S.lots.push([c,d,q,p,fx===''?null:+fx]);S.prices[c]=S.prices[c]||p}
else{const r=LC.R[c];if(!r||r.q<q){alert('目前持有 '+(r?r.q:0)+' 股，不夠賣 '+q+' 股');return}S.sells.push([c,d,q,p,fx===''?null:+fx,tx===''?null:+tx])}}
save();render()}
function exp(){$('bk').value=JSON.stringify(S)}
function imp(){try{const x=JSON.parse($('bk').value);if(!x.lots||!x.funds)throw 0;S=x;fix();save();render()}catch(e){alert('內容格式不正確，無法還原')}}
document.addEventListener('change',e=>{const t=e.target,ds=t.dataset;
if(t.id==='mc'){$('mp').value=S.prices[t.value]||'';sim();return}
if(t.id==='rt'){rtf();return}
if(t.closest('#simf'))return;
if(t.id==='pd'){S.pdate=t.value}else if(t.id==='dm'){S.divMode=t.value}else if(ds.p){S.prices[ds.p]=+t.value}else if(ds.s){S.set[ds.s]=+t.value}else if(ds.m){S.funds[ds.m].m=+t.value}else if(ds.c){S.funds[ds.c].c=+t.value}else if(ds.a){if(t.value==='')delete S.divAct[ds.a];else S.divAct[ds.a]=+t.value}else return;save();render()});
document.addEventListener('input',e=>{if(e.target.closest('#simf'))sim()});
document.addEventListener('click',e=>{const ds=e.target.dataset;
if(ds.f!==undefined){F=ds.f;render()}
else if(ds.t!==undefined){TAB=ds.t;render()}
else if(ds.rt!==undefined){RT=ds.rt;render()}
else if(ds.dl!==undefined){if(confirm('刪除這筆買進？')){S.lots.splice(+ds.dl,1);save();render()}}
else if(ds.ds!==undefined){if(confirm('刪除這筆賣出？')){S.sells.splice(+ds.ds,1);save();render()}}
else if(ds.dm!==undefined){if(confirm('刪除這筆股息？')){S.mdiv.splice(+ds.dm,1);save();render()}}});
render();
</script></body></html>
